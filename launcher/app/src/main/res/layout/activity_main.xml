<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="#080F19">
    <ImageView android:id="@+id/homeWallpaper" android:layout_width="match_parent"
        android:layout_height="match_parent" android:scaleType="centerCrop"
        android:contentDescription="Wallpaper" />
    <View android:layout_width="match_parent" android:layout_height="match_parent"
        android:background="#33030B14"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
        android:padding="16dp" android:orientation="vertical">
        <TextView android:layout_width="wrap_content" android:layout_height="38dp"
            android:text="MEKXZ DRIVE  X" android:textStyle="bold" android:textColor="#FFFFFFFF"
            android:textSize="24sp"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp"
            android:layout_weight="1" android:orientation="horizontal">
            <LinearLayout android:layout_width="0dp" android:layout_height="match_parent"
                android:layout_weight="1" android:orientation="vertical">
                <TextClock android:id="@+id/clockWidget" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:format24Hour="HH:mm"
                    android:format12Hour="hh:mm" android:textSize="66sp" android:textStyle="bold"
                    android:textColor="#FFFFFF"/>
                <TextClock android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:format24Hour="EEE, d MMM yyyy" android:format12Hour="EEE, d MMM yyyy"
                    android:textColor="#FFFFFF" android:textSize="18sp"/>
                <TextView android:id="@+id/weatherText" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:layout_marginTop="10dp"
                    android:text="Cuaca • Buka Settings untuk lokasi"
                    android:textColor="#FFFFFF" android:textSize="17sp"/>
                <Space android:layout_width="1dp" android:layout_height="0dp" android:layout_weight="1"/>
                <GridLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:columnCount="3" android:rowCount="2">
                    <Button android:id="@+id/dockApp1" style="@style/Widget.AppCompat.Button.Borderless"
                        android:layout_width="95dp" android:layout_height="60dp" android:text="Netflix"
                        android:textAllCaps="false" android:textColor="#FFFFFF"/>
                    <Button android:id="@+id/dockApp2" style="@style/Widget.AppCompat.Button.Borderless"
                        android:layout_width="95dp" android:layout_height="60dp" android:text="Music"
                        android:textAllCaps="false" android:textColor="#FFFFFF"/>
                    <Button android:id="@+id/dockApp3" style="@style/Widget.AppCompat.Button.Borderless"
                        android:layout_width="95dp" android:layout_height="60dp" android:text="Radio"
                        android:textAllCaps="false" android:textColor="#FFFFFF"/>
                    <Button android:id="@+id/dockApp4" style="@style/Widget.AppCompat.Button.Borderless"
                        android:layout_width="95dp" android:layout_height="60dp" android:text="YouTube"
                        android:textAllCaps="false" android:textColor="#FFFFFF"/>
                    <Button android:id="@+id/btnAllApps" style="@style/Widget.AppCompat.Button.Borderless"
                        android:layout_width="95dp" android:layout_height="60dp" android:text="All Apps"
                        android:textAllCaps="false" android:textColor="#FFFFFF"/>
                    <Button android:id="@+id/btnSettings" style="@style/Widget.AppCompat.Button.Borderless"
                        android:layout_width="95dp" android:layout_height="60dp" android:text="Settings"
                        android:textAllCaps="false" android:textColor="#FFFFFF"/>
                </GridLayout>
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="match_parent"
                android:layout_weight="1" android:gravity="right" android:orientation="vertical">
                <LinearLayout android:layout_width="270dp" android:layout_height="0dp"
                    android:layout_weight="1" android:background="@drawable/bg_frosted_glass"
                    android:padding="14dp" android:orientation="vertical">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="☪  Waktu Solat" android:textSize="23sp" android:textStyle="bold"
                        android:textColor="#FFFFFF"/>
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="KULIM" android:textColor="#CCDDEEFF"/>
                    <TextView android:id="@+id/prayerText" android:layout_width="match_parent"
                        android:layout_height="0dp" android:layout_weight="1"
                        android:gravity="center_vertical" android:text="Memuat waktu solat…"
                        android:textSize="17sp" android:lineSpacingExtra="6dp"
                        android:textColor="#FFFFFF"/>
                    <Switch android:id="@+id/azanSwitch" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:text="Azan &amp; Notifikasi"
                        android:textColor="#FFFFFF" android:checked="false"/>
                </LinearLayout>
                <Space android:layout_width="1dp" android:layout_height="14dp"/>
                <LinearLayout android:layout_width="match_parent" android:layout_height="144dp"
                    android:background="@drawable/bg_frosted_glass" android:padding="12dp"
                    android:orientation="vertical">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp"
                        android:layout_weight="1" android:gravity="center_vertical" android:orientation="horizontal">
                        <FrameLayout android:layout_width="64dp" android:layout_height="64dp"
                            android:background="@drawable/bg_media_artwork">
                            <ImageView android:id="@+id/mediaArtwork" android:layout_width="match_parent"
                                android:layout_height="match_parent" android:padding="10dp"
                                android:src="@android:drawable/ic_media_play" android:scaleType="centerInside"
                                android:contentDescription="Album artwork"/>
                        </FrameLayout>
                        <LinearLayout android:layout_width="0dp" android:layout_weight="1"
                            android:layout_height="wrap_content" android:layout_marginStart="12dp"
                            android:orientation="vertical">
                            <TextView android:text="NOW PLAYING" android:layout_width="match_parent"
                                android:layout_height="wrap_content" android:textColor="#8DB6D5"
                                android:textStyle="bold" android:textSize="10sp"/>
                            <TextView android:id="@+id/mediaTitle" android:layout_width="match_parent"
                                android:layout_height="wrap_content" android:text="Tiada media dimainkan"
                                android:textStyle="bold" android:textSize="16sp" android:textColor="#FFFFFF"
                                android:singleLine="true" android:ellipsize="end"/>
                            <TextView android:id="@+id/mediaArtist" android:layout_width="match_parent"
                                android:layout_height="wrap_content" android:text="Buka aplikasi muzik"
                                android:textSize="12sp" android:textColor="#BBFFFFFF"
                                android:singleLine="true" android:ellipsize="end"/>
                        </LinearLayout>
                    </LinearLayout>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="52dp"
                        android:gravity="center" android:orientation="horizontal">
                        <ImageButton android:id="@+id/mediaPrevious" android:layout_width="52dp"
                            android:layout_height="48dp" android:layout_marginEnd="12dp"
                            android:src="@android:drawable/ic_media_previous" android:tint="#EAF5FF"
                            android:background="@drawable/bg_media_control"
                            android:contentDescription="Previous track"/>
                        <ImageButton android:id="@+id/mediaPlayPause" android:layout_width="58dp"
                            android:layout_height="50dp" android:layout_marginEnd="12dp"
                            android:src="@android:drawable/ic_media_play" android:tint="#FFFFFF"
                            android:background="@drawable/bg_media_play"
                            android:contentDescription="Play or pause"/>
                        <ImageButton android:id="@+id/mediaNext" android:layout_width="52dp"
                            android:layout_height="48dp" android:src="@android:drawable/ic_media_next"
                            android:tint="#EAF5FF" android:background="@drawable/bg_media_control"
                            android:contentDescription="Next track"/>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>